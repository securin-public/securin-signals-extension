{
  "name": "securin-signals-extension",
  "version": "1.1.0",
  "private": true,
  "description": "Detect CVE IDs on any webpage, show Securin signals on hover, and open the Securin Signals record.",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "npm run typecheck && vite build && vite build --config vite.content.config.ts",
    "package": "npm run build && cd dist && rm -f ../securin-signals.zip && zip -qr ../securin-signals.zip .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "node scripts/generate-icons.mjs",
    "check": "npm run lint && npm run format:check && npm test && npm run build",
    "demo": "node scripts/serve-demo.mjs"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/chrome": "0.0.287",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  }
}
